# ── ClickUp ──────────────────────────────────────────────────────────────────
# Get from: https://app.clickup.com/settings/apps
CLICKUP_API_TOKEN=pk_your_token_here

# Found in your workspace URL: app.clickup.com/{TEAM_ID}/...
# Leave blank to auto-use first workspace
CLICKUP_TEAM_ID=

# Optional: filter time entries to a specific user ID
# Get via: GET /api/v2/team → members[].user.id
CLICKUP_ASSIGNEE_ID=

# ── Invoice ───────────────────────────────────────────────────────────────────
HOURLY_RATE=50

# ── TopTracker ───────────────────────────────────────────────────────────────
TOPTRACKER_EMAIL=you@example.com
TOPTRACKER_PASSWORD=your_password_here

# Must match project name exactly as shown in TopTracker
TOPTRACKER_PROJECT=My Client Project
